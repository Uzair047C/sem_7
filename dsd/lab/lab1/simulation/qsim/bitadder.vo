// \cout~0_combout  = (\B~input_o  & ((\A~input_o ) # (\C~input_o ))) # (!\B~input_o  & (\A~input_o  & \C~input_o ))

	.dataa(\B~input_o ),
	.datab(\A~input_o ),
	.datac(\C~input_o ),
	.datad(gnd),
	.cin(gnd),
	.combout(\cout~0_combout ),
	.cout());
// synopsys translate_off
